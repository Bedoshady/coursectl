# Copy to .env and adjust as needed. Every value shown is the built-in default.

# --- Upstream ---------------------------------------------------------------
COURSECTL_SITE_URL=https://eclass.yorku.ca
COURSECTL_SERVICE=moodle_mobile_app
COURSECTL_PASSPORT_HOST=passportyork.yorku.ca

# --- Server -----------------------------------------------------------------
COURSECTL_HOST=127.0.0.1
COURSECTL_PORT=8787
COURSECTL_LOG_LEVEL=info
COURSECTL_REQUEST_TIMEOUT=45
COURSECTL_LOGIN_TIMEOUT=90
# COURSECTL_CORS_ORIGINS=["https://myapp.example"]

# --- Storage ----------------------------------------------------------------
COURSECTL_DATABASE_PATH=data/coursectl.db
COURSECTL_SECRET_KEY_FILE=data/fernet.key
COURSECTL_DOWNLOAD_DIR=data/downloads

# --- Access control ---------------------------------------------------------
# Set to false to stop strangers from provisioning accounts on your instance.
COURSECTL_ALLOW_OPEN_REGISTRATION=true
# COURSECTL_REGISTRATION_SECRET=change-me
# Enables /v1/admin/* when set.
# COURSECTL_ADMIN_TOKEN=change-me-too

# --- MCP --------------------------------------------------------------------
# COURSECTL_MCP_ACCOUNT=abc123
# COURSECTL_MCP_API_KEY=ck_...
# COURSECTL_MCP_TRANSPORT=stdio
