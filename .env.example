# Copy to .env and adjust as needed. Every value shown is the built-in default.

# --- Upstream ---------------------------------------------------------------
ECLASS_SITE_URL=https://eclass.yorku.ca
ECLASS_SERVICE=moodle_mobile_app
ECLASS_PASSPORT_HOST=passportyork.yorku.ca

# --- Server -----------------------------------------------------------------
ECLASS_HOST=127.0.0.1
ECLASS_PORT=8787
ECLASS_LOG_LEVEL=info
ECLASS_REQUEST_TIMEOUT=45
ECLASS_LOGIN_TIMEOUT=90
# ECLASS_CORS_ORIGINS=["https://myapp.example"]

# --- Storage ----------------------------------------------------------------
ECLASS_DATABASE_PATH=data/eclass.db
ECLASS_SECRET_KEY_FILE=data/fernet.key
ECLASS_DOWNLOAD_DIR=data/downloads

# --- Access control ---------------------------------------------------------
# Set to false to stop strangers from provisioning accounts on your instance.
ECLASS_ALLOW_OPEN_REGISTRATION=true
# ECLASS_REGISTRATION_SECRET=change-me
# Enables /v1/admin/* when set.
# ECLASS_ADMIN_TOKEN=change-me-too

# --- MCP --------------------------------------------------------------------
# ECLASS_MCP_ACCOUNT=abc123
# ECLASS_MCP_API_KEY=ek_...
# ECLASS_MCP_TRANSPORT=stdio
